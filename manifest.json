{
    "manifest_version": 3,
    "name": "LLM Search Enhancer",
    "version": "1.0",
    "description": "Augments search with LLM responses (ChatGPT, Grok, etc.)",
    "permissions": [
      "activeTab",
      "storage",
      "https://api.openai.com/*",
      "https://api.x.ai/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://www.google.com/search*"],
        "js": ["content.js"]
      }
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    }
  }